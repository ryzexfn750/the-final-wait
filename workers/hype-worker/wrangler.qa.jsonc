{
  "name": "the-final-wait-hype-qa",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HYPE_ROOMS",
        "class_name": "HypeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HypeRoom"
      ]
    }
  ]
}
